<?xml version="1.0"?>
<robot name="spinjorr">

  <!-- Root link -->
  <link name="hoop_link">
    <inertial>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0016" ixy="0.0" ixz="0.0"
               iyy="0.0011" iyz="0.0"
               izz="0.0011"/>
    </inertial>

    <!-- Visual -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="barrel_hoop.stl" scale="1 1 1"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.973 0.576 0.000 1.0"/>
      </material>
    </visual>

    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="barrel_hoop.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <!-- Pendulum joint -->
  <joint name="pendulum_joint" type="revolute">
    <parent link="hoop_link"/>
    <child link="pendulum_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="10"/>
  </joint>

  <link name="pendulum_link">
    <inertial>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.00066" ixy="0.0" ixz="0.0"
               iyy="0.00066" iyz="0.0"
               izz="0.00063"/>
    </inertial>

    <visual>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.12"/>
      </geometry>
      <material name="red">
        <color rgba="0.9 0.1 0.1 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.12"/>
      </geometry>
    </collision>
  </link>

  <!-- Rotor joint -->
  <joint name="rotor_joint" type="revolute">
    <parent link="pendulum_link"/>
    <child link="rotor_link"/>
    <origin xyz="0 0 -0.07" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="10"/>
  </joint>

  <link name="rotor_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="0.000013" ixy="0.0" ixz="0.0"
               iyy="0.000013" iyz="0.0"
               izz="0.000026"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.01"/>
      </geometry>
      <material name="green">
        <color rgba="0.1 0.8 0.1 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.01"/>
      </geometry>
    </collision>
  </link>

</robot>