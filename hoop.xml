<mujoco>
  <option gravity="0 0 -9.81" timestep="0.001"  />
  <visual>
    <global offheight="2160" offwidth="3840"/>
    <quality offsamples="8" shadowsize="0"/>


    <rgba contactforce="1 0 0 1" contactfriction=" 0 0 1 1"/>
    <scale contactwidth="0.01"
        contactheight="0.1"
        forcewidth="0.05"/>


  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker"
            rgb1="0.52 0.72 0.85"
            rgb2="0.60 0.80 0.90"
            width="30" height="30" mark="none"/>


    <material name="grid" texture="grid" texrepeat="6 6"
              texuniform="true" reflectance="0.0"/>
    <material name="wall" rgba='.8 .5 .5 1'/>
    <mesh name="hoop_vis_mesh" file="hoop1.stl" scale="0.001 0.001 0.001"/>
  </asset>



<worldbody>
  <light name="light" pos="-.2 0 3" diffuse="1 1 1" specular="0 1 1" ambient="0.2 0.2 0.2" />


  <geom name="ground" type="plane" size="100 5 0.1" material="grid"
        zaxis="0 0 1" friction=".8 0 0"
        solimp="0.9 0.95 0.002 0.5 2" solref="0.002 2"
        contype="1" conaffinity="1"/>

  <camera name="y" pos="0 0 0.05" euler="90 0 0"/>

  <body name="hoop" pos="0 0 0.1" euler="0 0 0">
    <joint name="hoop_joint" type="free" />
    <inertial mass="0.4" pos="0 0 0"   fullinertia="0.0016 0.0011 0.0011 0 0 0"/>

    <!-- Collision proxy (invisible): cylinder; axis along +x via euler="90 0 0" -->
    <!-- <geom name="hoop_geom_col" type="cylinder" size="0.10 0.005" euler="-90 0 0"
          rgba="1 0.65 0.2 0.51"
          solimp="0.9 0.95 0.002 0.5 2" solref="0.002 2"
          contype="1" conaffinity="1"/>
    <site name="IMU" pos="0 0 0" euler="90 0 0"/> -->
    <geom name="hoop_geom_col" type="mesh" mesh="hoop_vis_mesh"
      euler="0 0 0"
      rgba="1.0 0.65 0.2 1"
      contype="1" conaffinity="1"
      solimp="0.9 0.95 0.001 0.5 2" solref="0.02 2"/>
    <site name="IMU" pos="0 0 0" euler="90 0 0"/>

    <!-- Visual mesh (no collision): STL -->
    <!-- If your STL’s axis is different, adjust euler/scale. Many rings modeled with axis along +z,
         so rotate to match the collision cylinder (axis +x) using euler="0 90 0" OR keep 90 0 0 if already aligned. -->
    <!-- <geom name="hoop_geom_vis" type="mesh" mesh="hoop_vis_mesh"
          euler="0 0 0"
          rgba="0.8 0.8 0.8 1"
          contype="0" conaffinity="0"/> -->

    <body name="pend_body" pos="0 0.017 0">
      <joint name="pend" type="hinge" pos="0 0.0 0" axis="0 1 0" damping = "0.001"/>
      <inertial mass="0.45" pos="0 0 -0.04" fullinertia="0.00066 0.00066 0.00063 0 0 0"/>

      <!-- Pendulum: no collisions -->
      <geom name="pendulum" type="cylinder" pos="0 0 -0.03" size="0.01 0.03"
            rgba="1 1 1 0.3" euler="0 0 0"
            contype="2" conaffinity="0"/>


      <body name="rotor_body" pos="0 0 -0.070">
        <joint name="rotor" type="hinge" pos="0 0 0" axis="0 0 1" damping = ".001"/>
        <inertial mass="0.03" pos="0 0 -0.07" fullinertia="0.000013 0.000013 0.000026 0 0 0"/>

        <!-- Rotor: thin disc; no collisions -->
        <geom name="rotor_mesh" type="cylinder" pos="0 0 0" size="0.03 0.001"
              rgba="1 1 0.8 0.3" euler="0 0 0"
              contype="2" conaffinity="0"/>
      </body>
    </body>
  </body>
</worldbody>


  <sensor>
    <jointpos name="pend_jointpos" joint="pend" />
    <accelerometer name="accelerometer" site="IMU"/>
    <gyro name="gyroscope" site="IMU"/>
  </sensor>
  <actuator>
    <motor name="my_motor" joint="pend" />
    <motor name="twist_rotor" joint="rotor" />
  </actuator>
  <keyframe>
    <!-- qpos layout: [x y z qw qx qy qz | pend | rotor]; qvel: [vx vy vz wx wy wz | pend | rotor] -->
    <key name="k_at_13_822"

         qpos="3.54872 0.623403 0.0564989 0.705534 0.705525 -0.0471854 -0.0472258 48.7514 2221.72"
         qvel="0 0 0 0 0 0 0 0"
         ctrl="0 0"/>
  </keyframe>
</mujoco>