<?xml version="1.0"?>
<robot name="hoop_pendulum_rotor">

  <!-- ========================= -->
  <!-- World -->
  <!-- ========================= -->
  <link name="world"/>

  <!-- ========================= -->
  <!-- Hoop (floating base) -->
  <!-- ========================= -->
  <link name="hoop">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.4"/>
      <!-- fullinertia: Ixx Iyy Izz Ixy Ixz Iyz -->
      <inertia
        ixx="0.0016" iyy="0.0011" izz="0.0011"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>

    <!-- Collision: cylinder, axis along +x -->
    <collision>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/> <!-- -90 deg about x -->
      <geometry>
        <cylinder radius="0.10" length="0.04"/> <!-- MuJoCo: size = radius, half-length -->
      </geometry>
    </collision>

    <!-- Visual (same as collision for now) -->
    <visual>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.04"/>
      </geometry>
      <material name="orange">
        <color rgba="1 0.65 0.2 0.5"/>
      </material>
    </visual>
  </link>

  <!-- Floating joint (MuJoCo free joint equivalent) -->
  <joint name="hoop_joint" type="floating">
    <parent link="world"/>
    <child link="hoop"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- Pendulum body -->
  <!-- ========================= -->
  <link name="pend_body">
    <inertial>
      <origin xyz="0 0 -0.04" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia
        ixx="0.00066" iyy="0.00066" izz="0.00063"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>

    <visual>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.06"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 0.8"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.06"/>
      </geometry>
    </collision>
  </link>

  <joint name="pend" type="revolute">
    <parent link="hoop"/>
    <child link="pend_body"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.001"/>
    <limit lower="-3.1416" upper="3.1416" effort="100" velocity="100"/>
  </joint>

  <!-- ========================= -->
  <!-- Rotor body -->
  <!-- ========================= -->
  <link name="rotor_body">
    <inertial>
      <origin xyz="0 0 -0.07" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia
        ixx="0.000013" iyy="0.000013" izz="0.000026"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.002"/>
      </geometry>
      <material name="yellow">
        <color rgba="1 1 0.8 0.3"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.002"/>
      </geometry>
    </collision>
  </link>

  <joint name="rotor" type="revolute">
    <parent link="pend_body"/>
    <child link="rotor_body"/>
    <origin xyz="0 0 -0.07" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.001"/>
    <limit lower="-1e9" upper="1e9" effort="100" velocity="100"/>
  </joint>

</robot>
